# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments and secrets
.venv/
venv/
/env/
.env

# Jupyter
.ipynb_checkpoints/

# Data (keep the folder and its README, not the files)
data/*
!data/README.md
# Raw prices for the default tickers ARE committed (yfinance re-adjusts history
# over time, so a fresh download would not reproduce our results).
!data/raw/
data/raw/*
!data/raw/*.csv
!data/raw/SHA256SUMS

# Results: models and figures are not committed; the small tables, learning-curve
# logs and the run manifest of the reported run are, so README numbers can be
# checked from a fresh clone.
results/*
!results/README.md
!results/run_manifest.json
!results/tables/
results/tables/*
!results/tables/*.csv
!results/logs/
results/logs/*
!results/logs/*.csv
runs/
wandb/
ray_results/
*.pt
*.pth
*.ckpt
*.pkl
*.npy
*.npz

# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf

# OS / editor
.DS_Store
.idea/
.vscode/

# Slides build dependencies
slides/node_modules/
slides/*.pdf
slides/~$*.pptx
results_quick/
